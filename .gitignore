# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example

# Runtime data (確定例・更新後ロジック・認証情報)
# sample.txt と初期ロジック (*_initial.md) はリポジトリに残す
data/examples/*.json
data/logic/current.md
data/logic/current_version.txt
data/logic/versions/*
!data/logic/versions/.gitkeep
!data/logic/versions/*_initial.md
data/auth/*
!data/auth/.gitkeep
